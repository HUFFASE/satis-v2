// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DIREKTOR
  SATIS_MUDURU
}

enum ImportDataType {
  FORECAST
  TARGET
  ACTUAL
  CLOSING
  CRM
  VISITS
}

enum ImportStatus {
  SUCCESS
  FAILED
  REVERTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  imageUrl     String?  // Profile image/avatar URL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedVendors UserVendor[]
  managedVendors  Vendor[]     @relation("VendorManager")
  forecasts      Forecast[]
  importLogs     ImportLog[]
  auditLogs      AuditLog[]
  scorecards     SalesManagerScorecard[]
  weeklyForecastSheets WeeklyForecastSheet[]
}

model Vendor {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  managerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager   User?        @relation("VendorManager", fields: [managerId], references: [id])
  users     UserVendor[]
  aliases   VendorAlias[]
  forecasts Forecast[]
  targets   Target[]
  actuals   Actual[]
  closings           Closing[]
  vendorScorecards   VendorScorecard[]
  weeklyForecastSheets WeeklyForecastSheet[]

  @@index([managerId])
}

// DEPRECATED: superseded by Vendor.managerId (one-to-many: a manager can own multiple vendors).
// Kept temporarily for rollback safety after the backfill; scheduled for removal in a follow-up.
model UserVendor {
  id        String   @id @default(uuid())
  userId    String
  vendorId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}

model VendorAlias {
  id        String   @id @default(uuid())
  vendorId  String
  alias     String   @unique
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model FiscalPeriod {
  id               String   @id @default(uuid())
  fiscalYear       Int
  quarter          Int
  startDate        DateTime
  endDate          DateTime
  isLocked         Boolean  @default(false)
  createdAt        DateTime @default(now())

  forecasts        Forecast[]
  targets          Target[]
  actuals          Actual[]
  closings         Closing[]
  scorecards       SalesManagerScorecard[]
  vendorScorecards VendorScorecard[]
  weeklyForecastSheets WeeklyForecastSheet[]

  @@unique([fiscalYear, quarter])
}

model Forecast {
  id             String   @id @default(uuid())
  vendorId       String
  fiscalPeriodId String
  weekNumber     Int
  revenue        Decimal  @db.Decimal(18, 2)
  gp             Decimal  @db.Decimal(18, 2)
  note           String?
  isActive       Boolean  @default(true)
  submittedById  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  submittedBy  User         @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  @@unique([vendorId, fiscalPeriodId, weekNumber])
  @@index([vendorId, fiscalPeriodId, isActive])
  @@index([submittedById])
}

model Target {
  id             String   @id @default(uuid())
  vendorId       String
  fiscalPeriodId String
  /// Çeyrek toplamı. Anlamı DEĞİŞMEDİ — tüm raporlar bunu okumaya devam eder.
  /// Aylık kırılım girildiğinde revenue = revenueM1+M2+M3 olur.
  revenue        Decimal  @db.Decimal(18, 2)
  gp             Decimal  @db.Decimal(18, 2)
  /// Aylık kırılım. null = henüz girilmemiş (0 ile karıştırılmamalı).
  /// Ya altısı birden dolu olur ya da altısı birden null.
  revenueM1      Decimal? @db.Decimal(18, 2)
  revenueM2      Decimal? @db.Decimal(18, 2)
  revenueM3      Decimal? @db.Decimal(18, 2)
  gpM1           Decimal? @db.Decimal(18, 2)
  gpM2           Decimal? @db.Decimal(18, 2)
  gpM3           Decimal? @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)

  @@unique([vendorId, fiscalPeriodId])
  @@index([fiscalPeriodId])
}

model Actual {
  id             String   @id @default(uuid())
  vendorId       String
  fiscalPeriodId String
  weekNumber     Int
  /// Çeyrek Invoiced NSB toplamı (= invoicedNsbM1+M2+M3).
  invoiced       Decimal  @db.Decimal(18, 2)
  /// Çeyrek Backlog NSB toplamı (= backlogNsbM1+M2+M3).
  backlog        Decimal  @db.Decimal(18, 2)
  /// Aylık kırılım — null = henüz import edilmemiş (0 ile karıştırılmamalı).
  invoicedNsbM1  Decimal? @db.Decimal(18, 2)
  invoicedNsbM2  Decimal? @db.Decimal(18, 2)
  invoicedNsbM3  Decimal? @db.Decimal(18, 2)
  invoicedGpM1   Decimal? @db.Decimal(18, 2)
  invoicedGpM2   Decimal? @db.Decimal(18, 2)
  invoicedGpM3   Decimal? @db.Decimal(18, 2)
  backlogNsbM1   Decimal? @db.Decimal(18, 2)
  backlogNsbM2   Decimal? @db.Decimal(18, 2)
  backlogNsbM3   Decimal? @db.Decimal(18, 2)
  backlogGpM1    Decimal? @db.Decimal(18, 2)
  backlogGpM2    Decimal? @db.Decimal(18, 2)
  backlogGpM3    Decimal? @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)

  @@unique([vendorId, fiscalPeriodId, weekNumber])
  @@index([fiscalPeriodId])
}

model Closing {
  id             String   @id @default(uuid())
  vendorId       String
  fiscalPeriodId String
  /// Çeyrek toplamı. Anlamı DEĞİŞMEDİ — tüm raporlar bunu okumaya devam eder.
  revenue        Decimal  @db.Decimal(18, 2)
  gp             Decimal  @db.Decimal(18, 2)
  /// Aylık kırılım. null = henüz girilmemiş (0 ile karıştırılmamalı).
  revenueM1      Decimal? @db.Decimal(18, 2)
  revenueM2      Decimal? @db.Decimal(18, 2)
  revenueM3      Decimal? @db.Decimal(18, 2)
  gpM1           Decimal? @db.Decimal(18, 2)
  gpM2           Decimal? @db.Decimal(18, 2)
  gpM3           Decimal? @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)

  @@unique([vendorId, fiscalPeriodId])
  @@index([fiscalPeriodId])
}

/// Excel "BU DataApp Weekly Forecast report" formunun web karşılığı.
/// Bir vendor'ın belirli bir hafta için doldurduğu tüm girilebilir hücreler
/// `inputs` alanında saklanır; şeması src/lib/weekly-forecast/schema.ts.
/// Türetilmiş her değer (Q toplamları, achievement, GP% vb.) okuma anında
/// src/lib/weekly-forecast/calc.ts tarafından hesaplanır, saklanmaz.
model WeeklyForecastSheet {
  id             String   @id @default(uuid())
  vendorId       String
  fiscalPeriodId String
  weekNumber     Int
  inputs         Json
  /// Aynı (vendor, çeyrek) için geçerli olan hafta. Forecast.isActive ile aynı
  /// semantik: kaydedilen hafta true olur, diğer haftalar false'a düşer.
  isActive       Boolean  @default(true)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([vendorId, fiscalPeriodId, weekNumber])
  @@index([fiscalPeriodId, weekNumber])
  @@index([vendorId, fiscalPeriodId, isActive])
  @@index([updatedById])
}

model SalesManagerScorecard {
  id                  String   @id @default(uuid())
  managerName         String
  userId              String?
  fiscalPeriodId      String
  weekNumber          Int
  forecastAccuracy    Decimal  @default(100.00) @db.Decimal(5, 2)
  revenueAch          Decimal  @default(0.00) @db.Decimal(5, 2)
  gpAch               Decimal  @default(0.00) @db.Decimal(5, 2)
  weightedCrmPipeline Decimal  @default(0.00) @db.Decimal(18, 2)
  rawCrmPipeline      Decimal  @default(0.00) @db.Decimal(18, 2)
  tryWeightedPipeline Decimal  @default(0.00) @db.Decimal(18, 2)
  tryRawPipeline      Decimal  @default(0.00) @db.Decimal(18, 2)
  tryDealCount        Int      @default(0)
  overdueCount        Int      @default(0)
  crmHealthScore      Int      @default(100)
  actualVisits        Int      @default(0)
  targetVisits        Int      @default(0)
  overallScore        Decimal  @default(100.00) @db.Decimal(5, 2)
  managerComment      String?  @db.Text
  crmAuditJson        String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)

  @@unique([managerName, fiscalPeriodId, weekNumber])
  @@index([fiscalPeriodId, weekNumber])
}

model VendorScorecard {
  id                  String   @id @default(uuid())
  vendorName          String
  vendorId            String?
  fiscalPeriodId      String
  weekNumber          Int
  weightedCrmPipeline Decimal  @default(0.00) @db.Decimal(18, 2)
  rawCrmPipeline      Decimal  @default(0.00) @db.Decimal(18, 2)
  tryWeightedPipeline Decimal  @default(0.00) @db.Decimal(18, 2)
  tryRawPipeline      Decimal  @default(0.00) @db.Decimal(18, 2)
  tryDealCount        Int      @default(0)
  overdueCount        Int      @default(0)
  crmHealthScore      Int      @default(100)
  totalDeals          Int      @default(0)
  crmAuditJson        String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)

  @@unique([vendorName, fiscalPeriodId, weekNumber])
  @@index([fiscalPeriodId, weekNumber])
}

model ImportLog {
  id           String         @id @default(uuid())
  dataType     ImportDataType
  uploadedById String
  fileName     String
  rowCount     Int
  status       ImportStatus
  createdAt    DateTime       @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([uploadedById])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}
